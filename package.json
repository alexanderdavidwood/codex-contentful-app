{
  "name": "codex-powered-contentful-app-builder",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace @codex-builder/api",
    "build:app": "npm run build --workspace @codex-builder/contentful-app",
    "dev:api": "npm run dev --workspace @codex-builder/api",
    "dev:app": "npm run dev --workspace @codex-builder/contentful-app",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces"
  }
}
